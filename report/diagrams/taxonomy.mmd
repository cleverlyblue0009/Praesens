  R["Attacks on remote<br/>face verification"]:::root
  P["Presentation attacks<br/>(in front of the camera)"]:::pa
  I["Injection attacks<br/>(bypass the camera)"]:::ia
  P1["Printed photo"]:::pa
  P2["Screen replay"]:::pa
  P3["3D / silicone mask"]:::pa
  I1["Virtual camera feed<br/>(OBS, pyvirtualcam)"]:::ia
  I2["Real-time face swap /<br/>reenactment"]:::ia
  I3["Adaptive injector that<br/>mimics global brightness"]:::ia
  D1["Passive texture / CNN PAD<br/>(LBP, CDCN, ...)"]:::d
  D2["PRAESENS: active physical<br/>challenge-response"]:::d
  R --> P & I
