flowchart LR
  classDef root fill:#1F3A68,color:#fff,stroke:#1F3A68,font-weight:bold
  classDef pa fill:#FDEBD0,stroke:#E07A1F,stroke-width:2px,color:#111
  classDef ia fill:#FADBD8,stroke:#C0392B,stroke-width:2px,color:#111
